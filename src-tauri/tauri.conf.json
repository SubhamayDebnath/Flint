{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flint",
  "version": "0.2.0",
  "identifier": "com.unpaidbot.flint",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flint",
        "width": 480,
        "height": 48,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-sync --disable-default-apps --no-first-run"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "unpaidbot",
    "copyright": "Copyright © 2026 unpaidbot",
    "category": "Utility",
    "shortDescription": "Instant, offline, keyboard-first Windows launcher",
    "longDescription": "Flint is a fast, lightweight, completely offline launcher for apps, files and system commands. Press Alt+Space, type, press Enter. Published by unpaidbot.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Flint",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
